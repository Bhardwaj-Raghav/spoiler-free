{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "outDir": "assets/scripts/",
    "rootDir": "./src/script",
    "types": ["chrome"],
    "isolatedModules": true
  },
  "include": ["src/script/**/*.ts"],
  "exclude": ["node_modules"]
}
